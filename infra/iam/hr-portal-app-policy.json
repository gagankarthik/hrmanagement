{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmployeeTableAndIndexes",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-2:417915984158:table/HRManagement-Employees",
        "arn:aws:dynamodb:us-east-2:417915984158:table/HRManagement-Employees/index/*"
      ]
    },
    {
      "Sid": "DocumentUploads",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::zenhr-documents-system/*"
    },
    {
      "Sid": "DocumentBucketListing",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::zenhr-documents-system"
    },
    {
      "Sid": "BackupsPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::oceanblue-backups-tables/hr-employee-table-backups/*"
    },
    {
      "Sid": "BackupsListingPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::oceanblue-backups-tables",
      "Condition": {
        "StringLike": { "s3:prefix": ["hr-employee-table-backups/*"] }
      }
    },
    {
      "Sid": "HrUserPoolOnly",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminUpdateUserAttributes",
        "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminRemoveUserFromGroup",
        "cognito-idp:AdminListGroupsForUser",
        "cognito-idp:AdminEnableUser",
        "cognito-idp:AdminDisableUser",
        "cognito-idp:ListUsers",
        "cognito-idp:ListUsersInGroup",
        "cognito-idp:ListGroups",
        "cognito-idp:CreateGroup",
        "cognito-idp:AddCustomAttributes",
        "cognito-idp:DescribeUserPool"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-2:417915984158:userpool/us-east-2_IeDCRVfiW"
    }
  ]
}
